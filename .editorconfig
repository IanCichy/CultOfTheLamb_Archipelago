root = true

[*]
end_of_line = crlf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{yaml,yml,json}]
indent_size = 2

[*.py]
max_line_length = 100

[*.cs]
# Braces on every control-flow body, including single statements.
csharp_prefer_braces = true
dotnet_diagnostic.IDE0011.severity = warning
