<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The game runs on Mono, and COTL_API targets net472. Do not retarget. -->
    <TargetFramework>net472</TargetFramework>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <VersionPrefix>0.9.5</VersionPrefix>
    <OutputPath>bin\$(Configuration)</OutputPath>
  </PropertyGroup>

  <Target Name="CopyMod" AfterTargets="PostBuildEvent">
    <MakeDir Directories="bin/zip/" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="bin/Build/" />
    <Copy SourceFiles="$(OutputPath)/Archipelago.MultiClient.Net.dll;$(OutputPath)/Newtonsoft.Json.dll;" DestinationFolder="bin/Build/" />
    <!-- Thunderstore and r2modman read these from the zip root. -->
    <Copy SourceFiles="../README.md;../manifest.json;../CHANGELOG.md;../icon.png;../LICENSE" DestinationFolder="bin/Build/" />
    <Copy Condition="'$(ModFolder)' != ''" SourceFiles="$(TargetPath);$(TargetDir)/$(TargetName).pdb" DestinationFolder="$(ModFolder)" />
    <Copy Condition="'$(ModFolder)' != ''" SourceFiles="$(OutputPath)/Archipelago.MultiClient.Net.dll;$(OutputPath)/Newtonsoft.Json.dll;" DestinationFolder="$(ModFolder)" />
    <!-- Renames a debug-keys build so it cannot be mistaken for a release. -->
    <PropertyGroup>
      <PackageSuffix Condition="$(DefineConstants.Contains('AP_DEBUG_KEYS'))">-DEVBUILD-DO-NOT-SHARE</PackageSuffix>
    </PropertyGroup>
    <ZipDirectory SourceDirectory="bin/Build" DestinationFile="bin/zip/Archipelago_CultOfTheLamb-$(VersionPrefix)$(PackageSuffix).zip" Overwrite="true" />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="Assets\APTarotCard.png" />
    <EmbeddedResource Include="Assets\ap_icon.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.0.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.1.0" />
    <PackageReference Include="Archipelago.MultiClient.Net" Version="6.7.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.16" IncludeAssets="compile" />
    <PackageReference Include="CultOfTheLamb.GameLibs" Version="1.5.15.979-r.0" />
  </ItemGroup>
</Project>
